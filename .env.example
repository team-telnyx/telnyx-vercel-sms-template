# Set automatically when you connect a Telnyx number from the Vercel Marketplace
# to this project (Project > Settings > Environment Variables). For local
# development: `vercel env pull .env.local`, or copy the values by hand.

# Scoped Telnyx token for this number: messages and call control only.
TELNYX_API_KEY=
# Your number in E.164 (+1...). Arrives after the one-time identity check.
TELNYX_PHONE_NUMBER=
# Messaging profile the number belongs to (US destinations only).
TELNYX_MESSAGING_PROFILE_ID=
# Where Telnyx sends inbound texts and delivery receipts:
# https://<your-production-domain>/api/telnyx/inbound once connected.
TELNYX_MESSAGING_WEBHOOK_URL=
# Ed25519 public key (base64) for verifying Telnyx webhook signatures.
TELNYX_PUBLIC_KEY=
# Call Control app for this number. Only set when the number has calling;
# without it the app is SMS only.
TELNYX_CONNECTION_ID=
# Where Telnyx sends call events: https://<your-production-domain>/api/telnyx/voice
TELNYX_VOICE_WEBHOOK_URL=

# You choose this. The deploy button asks for it. It protects the send form so
# strangers can't send texts on your balance. Sending is off while it's empty.
SEND_FORM_PASSWORD=
