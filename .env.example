# Set automatically when you connect a Telnyx number from the Vercel Marketplace
# to this project (Project > Settings > Environment Variables). For local
# development: `vercel env pull .env.local`, or copy the values by hand.

# Scoped Telnyx token for this number: send and read messages only.
TELNYX_API_KEY=
# Your number in E.164 (+1...). Arrives after the one-time identity check.
TELNYX_PHONE_NUMBER=
# Messaging profile the number belongs to (US destinations only).
TELNYX_MESSAGING_PROFILE_ID=
# Where Telnyx sends inbound texts and delivery receipts:
# https://<your-production-domain>/api/telnyx/inbound once connected.
TELNYX_MESSAGING_WEBHOOK_URL=
# Ed25519 public key (base64) for verifying Telnyx webhook signatures.
TELNYX_PUBLIC_KEY=
# Opens your Telnyx dashboard through Vercel sign-in (the page's Open Telnyx and
# Register buttons). Without it, they open the Telnyx integration page in Vercel.
TELNYX_DASHBOARD_URL=

# Optional, you choose these. Add them in Project > Settings > Environment
# Variables, then redeploy.

# Turns on "Send to any US number" on the home page, protected by this password.
# Without it, the page only texts phones that texted its pairing code first.
SEND_FORM_PASSWORD=
# Texts per day the home page may send (default 25).
DAILY_SEND_LIMIT=
